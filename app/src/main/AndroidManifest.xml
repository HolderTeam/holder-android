<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11/API 30+): without this, PackageManager hides other
         installed apps from our own queries by default, including a genuinely installed
         browser. GitHubActivityBrowserLauncher.resolveLaunchKind's CustomTabsClient
         .getPackageName and its ordinary-browser fallback both silently see nothing without
         this, misreporting BrowserUnavailable even when Chrome is actually installed.
         Confirmed live: this exact failure reproduced on real emulators (API 33/37) before
         this was added. One query shape covers both Custom Tabs provider detection and the
         plain-browser fallback: CustomTabsClient's own resolution logic queries for this
         identical intent shape internally. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Holder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Holder"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Files/Downloads/an email client offer "Open with Holder" for a .hrk
                 recovery-key export (see holder-desktop's recovery_service.vala, which produces
                 that same extension), straight to Recover Project with the token pre-filled,
                 rather than the user having to copy its text out by hand. singleTop above means
                 an already-running Holder gets this via onNewIntent rather than a second
                 instance.

                 Two independent filters, deliberately not combined into one: mixing a
                 mimeType constraint and a pathPattern constraint in the same intent-filter's
                 data set made real-device matching inconsistent (a MediaStore-backed content://
                 URI matched; a DocumentsProvider-backed one, what Files/Downloads actually hand
                 off, didn't). Keeping them apart avoids Android combining them into one
                 stricter, harder-to-satisfy requirement. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.hrk" />
            </intent-filter>

            <!-- Covers a content:// URI whose path is an opaque document/attachment id rather
                 than the real filename (the common case for Files/Downloads/an email client),
                 where pathPattern above can't match at all. application/octet-stream is what
                 most such providers fall back to for a .hrk file, since it's not a MIME type
                 Android has any built-in association for. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- holder-github-service's two App Link return paths (see that repo's
                 GITHUB_SETUP_SERVICE_PLAN.md, "Redirect mechanism" and "Setup URL,
                 reconsidered"). ${oauthHost} is a manifestPlaceholder set per buildType in
                 app/build.gradle.kts (production vs. development relay/GitHub App).
                 (Note: this comment avoids a literal double hyphen anywhere in its text, since
                 that breaks XML comment parsing.)

                 Both delivery paths (an ordinary Custom Tab/browser fallback arriving here via
                 this filter, or Auth Tab's own ActivityResultCallback delivering its result
                 directly to whichever Activity launched it) funnel into the SAME completion
                 logic in GitHubConnectionCoordinator (handleOAuthCallbackUri /
                 handleAuthTabResult). This filter is specifically the delivery mechanism for
                 the non Auth Tab case, not a claim that Auth Tab results are handled by
                 different logic.

                 Five separate data elements, one attribute each, deliberately: Android merges
                 all data elements in one intent filter together, so this declares exactly
                 {http,https} x {oauthHost} x {both paths}, matching the plan's own recipe. Both
                 http and https must be declared for Digital Asset Links verification itself to
                 work at all, even though this app only ever acts on an https navigation,
                 confirmed directly against Android's own App Links docs, which are explicit
                 that an intent filter must include data elements for both http and https
                 schemes for verification to succeed. The runtime callback validator
                 (GitHubConnectionCoordinator.isOAuthCallbackEndpoint) continues to accept the
                 exact https endpoint only, never http; declaring the scheme here is a
                 verification requirement, not a relaxation of what's actually delivered.

                 autoVerify requires holder github service's ANDROID_SHA256_CERT_FINGERPRINTS
                 (and, for the debug build specifically, ANDROID_PACKAGE_NAME matching this
                 build's own applicationIdSuffix) to be real to actually pass Digital Asset
                 Links verification. This is load bearing security, not a cosmetic return path
                 (see that repo's wrangler.jsonc): it's one of the three layers (App Link
                 routing, local state correlation, PKCE) this design's actual security rests
                 on. Development wires the real, checked in debug.keystore fingerprint;
                 production remains a placeholder, genuinely blocked on a real Play Console app
                 existing. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="${oauthHost}" />
                <data android:path="/android/oauth-callback" />
                <data android:path="/github/install-complete" />
            </intent-filter>
        </activity>

        <!-- Grants other apps read-only, revocable access to a downloaded Resource
             attachment so it can be opened externally (ACTION_VIEW). See
             team.holder.android.resource.openResourceExternally. Only the
             resource-attachments cache subdirectory is exposed; see file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>