<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Holder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Holder"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Files/Downloads/an email client offer "Open with Holder" for a .hrk
                 recovery-key export (see holder-desktop's recovery_service.vala, which produces
                 that same extension), straight to Recover Project with the token pre-filled,
                 rather than the user having to copy its text out by hand. Most apps that hand
                 off an unregistered extension like this present it as a generic mimeType (often
                 application/octet-stream) rather than anything .hrk-specific, so this matches on
                 the file name pattern instead, permissive on mimeType/scheme/host to catch
                 however a given app actually constructs the URI. singleTop above means an
                 already-running Holder gets this via onNewIntent rather than a second instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.hrk" />
            </intent-filter>
        </activity>

        <!-- Grants other apps read-only, revocable access to a downloaded Resource
             attachment so it can be opened externally (ACTION_VIEW). See
             team.holder.android.resource.openResourceExternally. Only the
             resource-attachments cache subdirectory is exposed; see file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>